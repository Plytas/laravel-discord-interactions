{
    "name": "plytas/laravel-discord-interactions",
    "description": "Build Discord bots in Laravel: slash commands, buttons, select menus and modals over HTTP webhooks. No gateway or long-running process.",
    "keywords": [
        "laravel",
        "php",
        "discord",
        "discord-bot",
        "discord-api",
        "discord-interactions",
        "interactions",
        "slash-commands",
        "application-commands",
        "buttons",
        "select-menu",
        "modals",
        "webhooks",
        "serverless",
        "bot"
    ],
    "homepage": "https://github.com/plytas/laravel-discord-interactions",
    "support": {
        "issues": "https://github.com/Plytas/laravel-discord-interactions/issues",
        "source": "https://github.com/Plytas/laravel-discord-interactions",
        "docs": "https://github.com/Plytas/laravel-discord-interactions#readme"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Plytas",
            "email": "vytautas@smilingis.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.50||^13.0",
        "illuminate/http": "^12.50||^13.0",
        "spatie/laravel-data": "^4.6",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.32.3",
        "nunomaduro/collision": "^8.9.6",
        "larastan/larastan": "^3.15.0",
        "orchestra/testbench": "^11.3.0|^10.12.0",
        "pestphp/pest": "^4.7.8|^3.8.7",
        "pestphp/pest-plugin-arch": "^4.0.2|^3.1.1",
        "pestphp/pest-plugin-laravel": "^4.1.0|^3.2.0",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan-deprecation-rules": "^2.0.5",
        "phpstan/phpstan-phpunit": "^2.1.2",
        "spatie/laravel-ray": "^1.43.9"
    },
    "autoload": {
        "psr-4": {
            "Plytas\\Discord\\": "src/",
            "Plytas\\Discord\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Plytas\\Discord\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "clear": "@php vendor/bin/testbench package:purge-laravel-discord-interactions --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": [
            "@composer run prepare",
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "@composer run build",
            "@php vendor/bin/testbench serve"
        ],
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Plytas\\Discord\\DiscordServiceProvider"
            ],
            "aliases": {
                "Discord": "Plytas\\Discord\\Facades\\Discord"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
